exports[`recorded output: add-two-negs > matches the wording recorded when the skill landed 1`] = `
"--- add-two-negs · seed 1 · difficulty 1
prompt   What is the value?
display  inline "−4 + −1"
answer   exact -5/1
input    keypad
keypad   allowNegative=true
