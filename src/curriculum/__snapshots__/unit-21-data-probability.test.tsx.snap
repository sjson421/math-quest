exports[`Unit 21 recorded output: compound-probability > matches authored sample output 1`] = `
"--- compound-probability · seed 1 · difficulty 1
prompt   What is the probability of event A or event B?
display  story [compound-probability or first 1/3 second 1/3] "A group of 3 equally likely outcomes includes 1 for event A and 1 for event B."
answer   exact 2/3 (fraction)
input    keypad
keypad   allowFraction=true
hint     Add the two event probabilities.
step 1   Write each event as a fraction.   [1/3, 1/3]
step 2   Add the two fractions.   [1/3 + 1/3]
step 3   That is the exact probability.   [2/3]
miss     swapped-operation = 0.1111111111111111   Or means add the two probabilities.
miss     added-numerators-and-denominators = 0.3333333333333333   Turn each event into its own fraction before combining.

