exports[`recorded output: slope-from-graph > matches the wording recorded when the skill landed 1`] = `
"--- slope-from-graph · seed 1 · difficulty 1
prompt   What is the slope of this line?
display  coordinate-plane x -4..4/1 y -4..4/1 points [(0, 1), (4, 2)] lines [(0, 1)→(4, 2)] "Coordinate plane, x-axis −4 to 4 by 1; y-axis −4 to 4 by 1; points (0, 1) and (4, 2); line 1 through (0, 1) and (4, 2)" [slope-from-graph]
answer   exact 1/4
input    keypad
keypad   allowFraction=true allowNegative=false
hint     Keep the point order consistent and divide rise by run.
step 1   Subtract y-values in one point order.   [2 − 1 = 1]
step 2   Subtract x-values in that order too.   [4 − 0 = 4]
step 3   Divide rise by run and reduce.   [1/4 = 1/4]
miss     run-over-rise = 4   Slope is vertical change over horizontal change: rise over run.

--- slope-from-graph · seed 12345 · difficulty 1
prompt   What is the slope of this line?
display  coordinate-plane x -4..4/1 y -4..4/1 points [(−2, 1), (4, 4)] lines [(−2, 1)→(4, 4)] "Coordinate plane, x-axis −4 to 4 by 1; y-axis −4 to 4 by 1; points (−2, 1) and (4, 4); line 1 through (−2, 1) and (4, 4)" [slope-from-graph]
answer   exact 1/2
input    keypad
keypad   allowFraction=true allowNegative=false
hint     Keep the point order consistent and divide rise by run.
step 1   Subtract y-values in one point order.   [4 − 1 = 3]
step 2   Subtract x-values in that order too.   [4 − −2 = 6]
step 3   Divide rise by run and reduce.   [3/6 = 1/2]
miss     run-over-rise = 2   Slope is vertical change over horizontal change: rise over run.

--- slope-from-graph · seed 67890 · difficulty 1
prompt   What is the slope of this line?
display  coordinate-plane x -4..4/1 y -4..4/1 points [(−2, −3), (1, −2)] lines [(−2, −3)→(1, −2)] "Coordinate plane, x-axis −4 to 4 by 1; y-axis −4 to 4 by 1; points (−2, −3) and (1, −2); line 1 through (−2, −3) and (1, −2)" [slope-from-graph]
