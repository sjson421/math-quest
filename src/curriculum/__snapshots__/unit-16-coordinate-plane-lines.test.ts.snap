exports[`recorded output: graph-from-equation > matches the wording recorded when the skill landed 1`] = `
"--- graph-from-equation · seed 1 · difficulty 1
prompt   Which line matches the equation?
display  coordinate-plane x -4..4/1 y -4..4/1 points [] lines [(0, −1)→(1, 0), (0, 1)→(1, 2)] "Coordinate plane, x-axis −4 to 4 by 1; y-axis −4 to 4 by 1; line 1 through (0, −1) and (1, 0); line 2 through (0, 1) and (1, 2)" [graph-from-equation slope 1 intercept -1 y = x − 1]
answer   choice line-1
input    choice
hint     Match the slope and y-intercept, then identify its line style.
choice   line-1 = Line 1 (solid)
choice   line-2 = Line 2 (dashed)
step 1   Find the y-intercept at x equals zero.   [b = −1]
step 2   Check the rise for each run.   [m = 1]
step 3   Choose Line 1, solid.
miss     intercept-sign-reversed = line-2   Check the sign of the y-intercept before choosing a line.

--- graph-from-equation · seed 12345 · difficulty 1
prompt   Which line matches the equation?
display  coordinate-plane x -4..4/1 y -4..4/1 points [] lines [(0, 2)→(1, 4), (0, −2)→(1, 0)] "Coordinate plane, x-axis −4 to 4 by 1; y-axis −4 to 4 by 1; line 1 through (0, 2) and (1, 4); line 2 through (0, −2) and (1, 0)" [graph-from-equation slope 2 intercept 2 y = 2x + 2]
answer   choice line-1
input    choice
hint     Match the slope and y-intercept, then identify its line style.
choice   line-2 = Line 2 (dashed)
choice   line-1 = Line 1 (solid)
step 1   Find the y-intercept at x equals zero.   [b = 2]
step 2   Check the rise for each run.   [m = 2]
step 3   Choose Line 1, solid.
miss     intercept-sign-reversed = line-2   Check the sign of the y-intercept before choosing a line.

