exports[`recorded output: improper-to-mixed > matches the wording recorded when the skill landed 1`] = `
"--- improper-to-mixed · seed 1 · difficulty 1
prompt   Write this as a mixed number.
display  math "5 over 3" fraction("5", "3") [improper-to-mixed 5/3]
answer   exact 5/3 (simplified) (mixed)
input    keypad
keypad   allowMixed=true
hint     Divide the numerator by the denominator — the quotient is the whole part.
step 1   Divide the numerator by the denominator.   [5 ÷ 3 = 1 remainder 2]
step 2   The quotient is the whole part.   [1]
step 3   The remainder becomes the fraction numerator.   [2/3]
miss     quotient-remainder-swapped = 2.3333333333333335   The quotient is the whole part; the remainder is the fraction numerator.
miss     whole-with-original-fraction = 2.6666666666666665   Only the remainder becomes the fraction part.

--- improper-to-mixed · seed 12345 · difficulty 1
prompt   Write this as a mixed number.
display  math "6 over 4" fraction("6", "4") [improper-to-mixed 6/4]
answer   exact 6/4 (simplified) (mixed)
input    keypad
keypad   allowMixed=true
hint     Divide the numerator by the denominator — the quotient is the whole part.
step 1   Divide the numerator by the denominator.   [6 ÷ 4 = 1 remainder 2]
step 2   The quotient is the whole part.   [1]
step 3   The remainder becomes the fraction numerator.   [2/4]
step 4   Reduce to lowest terms.   [2/4 = 1/2]
miss     quotient-remainder-swapped = 2.25   The quotient is the whole part; the remainder is the fraction numerator.
miss     whole-with-original-fraction = 2.5   Only the remainder becomes the fraction part.

--- improper-to-mixed · seed 67890 · difficulty 1
