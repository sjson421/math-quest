exports[`recorded output: fraction-to-decimal > matches the wording recorded when the skill landed 1`] = `
"--- fraction-to-decimal · seed 1 · difficulty 1
prompt   Write this fraction as a decimal.
display  math "1 over 5" fraction("1", "5") [simplify 1/5]
answer   exact 1/5 (decimal)
input    keypad
keypad   allowDecimal=true allowFraction=true
hint     Divide 1 by 5.
