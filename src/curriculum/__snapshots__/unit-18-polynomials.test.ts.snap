exports[`Unit 18 recorded output: quadratic-formula > matches the wording recorded when the skill landed 1`] = `
"--- quadratic-formula · seed 1 · difficulty 1
prompt   Solve x² − x − 12 = 0 using a = 1, b = −1, c = −12.
display  math "x equals negative b plus or minus the square root of b squared minus four a c, all over two a" row("x", "=", fraction(row("−b", "±", root(row(superscript("b", "2"), "−", "4ac"))), "2a")) [quadratic-formula a=1 b=-1 c=-12]
answer   root-pair roots (-3, 4)
input    root-pair (Root 1, Root 2; one Check)
keypad   allowNegative=true allowFraction=false
hint     Substitute the coefficients, then use both signs before dividing.
step 1   Substitute a, b, and c.   [a = 1, b = −1, c = −12]
step 2   Evaluate the discriminant.   [b² − 4ac = 49]
step 3   Use both signs in the numerator.   [−b ± 7]
step 4   Divide each result by two a.   [-3, 4]
miss     used-positive-b = roots (-4, 3)   The numerator starts with negative b.
miss     divided-by-a = roots (-6, 8)   The denominator is two times a.

--- quadratic-formula · seed 12345 · difficulty 1
prompt   Solve x² + 3x − 4 = 0 using a = 1, b = 3, c = −4.
display  math "x equals negative b plus or minus the square root of b squared minus four a c, all over two a" row("x", "=", fraction(row("−b", "±", root(row(superscript("b", "2"), "−", "4ac"))), "2a")) [quadratic-formula a=1 b=3 c=-4]
