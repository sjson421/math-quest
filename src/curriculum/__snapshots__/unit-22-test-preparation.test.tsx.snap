exports[`Unit 22 content > timed-practice-1 records the complete output and stable intro 1`] = `
"--- exponent-meaning · seed 1 · difficulty 1
prompt   How many times is the base multiplied by itself?
display  math "4 × 4 × 4 equals 4 to the blank power" row("4 × 4 × 4 = ", superscript("4", "?")) [expand-power 4^3]
answer   exact 3/1
input    keypad
hint     Count how many times the base appears as a factor.
step 1   Count the repeated factors.   [4 × 4 × 4]
step 2   That count is the exponent.   [4^3]

--- one-step-addsub · seed 12345 · difficulty 1
prompt   Solve for x.
display  equation "x − 6 = −2" solve x [one-step-addsub x - 6 = -2]
answer   exact 4/1
input    keypad
keypad   allowNegative=true
hint     Do the opposite operation to both sides.
step 1   Add 6 on both sides.   [x = −2 + 6]
step 2   That leaves x alone.   [x = 4]
miss     repeated-operation = -8   The equation subtracts, so undo it by adding.

--- sub-mixed · seed 67890 · difficulty 1
prompt   What is the difference?
display  math "4 and 1 over 3, minus, 1 and 2 over 3" row(row("4", fraction("1", "3")), "−", row("1", fraction("2", "3"))) [sub-mixed 4 1/3 − 1 2/3]
answer   exact 8/3 (simplified) (mixed)
input    keypad
keypad   allowMixed=true
hint     Borrow one whole, then subtract the whole and fraction parts.
step 1   Borrow one whole as 3 fraction pieces.   [4 1/3 = 3 4/3]
step 2   Subtract the whole and fraction parts.   [3 4/3 − 1 2/3 = 2 2/3]
miss     reversed-fraction-without-borrowing = 3.3333333333333335   The smaller fraction part means one whole must be borrowed first.
miss     borrowed-one-piece = 2   One borrowed whole adds 3 fraction pieces, not one.

--- times-9 · seed 424242 · difficulty 1
prompt   What is the product?
display  inline "2 × 9"
answer   exact 18/1
input    keypad
hint     Use ten groups minus one; the digits in 18 add to 9.
step 1   Start with ten groups.   [10 × 2 = 20]
step 2   Take one group away.   [20 − 2 = 18]
step 3   Check the digits in 18: they add to 9.
miss     used-ten-groups = 20   That is ten groups. Take one group of 2 away.
miss     removed-two-groups = 16   That takes away two groups of 2; only one comes off ten groups.

--- scientific-notation · seed 987654321 · difficulty 1
prompt   Write this as an ordinary number.
display  math "6 times 10 to the negative 2 power" row("6 × ", superscript("10", "−2")) [scientific-notation 6e-0 × 10^-2]
answer   exact 3/50 (decimal)
input    keypad
keypad   allowDecimal=true
hint     Move the decimal 2 places left.
step 1   Use the exponent as the number of places.
step 2   Move the decimal left.   [0.06]
miss     moved-one-place = 0.6   The exponent moves the decimal 2 places, not one.
miss     reversed-exponent-direction = 600   A negative exponent moves the decimal left.

